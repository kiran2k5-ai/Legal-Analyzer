# ==============================================================================
# Legal AI Document Analyzer - Comprehensive Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Virtual Environments & Packages
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/
**/venv/
**/.venv/

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caches & Test Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Vector Database, Storage & Database Files
# ------------------------------------------------------------------------------
chroma_db/
**/chroma_db/
backend/chroma_db/
backend/services/chroma_db/
*.sqlite3
*.sqlite3-journal
*.sqlite
*.db

# ------------------------------------------------------------------------------
# 4. User Uploaded Documents & Processing Files
# ------------------------------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secret Configuration
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# 6. Frontend (Node.js / React / Vite) Artifacts
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/legal-ai/node_modules/
dist/
**/dist/
dist-ssr/
frontend/legal-ai/dist/
*.local
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 7. Log Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 8. IDE, Text Editors & Operating System Artifacts
# ------------------------------------------------------------------------------
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.tmp
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
